{
  "expo": {
    "name": "Planes de Lectura",
    "slug": "planes-lectura",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.vidaesperanzayverdad.planeslectura"
    },
    "android": {
      "package": "org.vidaesperanzayverdad.planeslectura",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications"
    ],
    "scheme": "planeslectura"
  }
}
